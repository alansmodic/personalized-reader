# Files marked export-ignore are excluded from `git archive` output.
# The release workflow uses git archive to build the distributable zip,
# so anything dev-only listed here stays out of installations.

/.github             export-ignore
/.gitattributes      export-ignore
/.gitignore          export-ignore
/.editorconfig       export-ignore
/composer.json       export-ignore
/composer.lock       export-ignore
/phpcs.xml.dist      export-ignore
/vendor              export-ignore
/node_modules        export-ignore
/tests               export-ignore

# Line endings — keep PHP/JS/CSS/MD as LF everywhere for diff sanity.
*.php text eol=lf
*.js  text eol=lf
*.css text eol=lf
*.md  text eol=lf
*.json text eol=lf
*.yml  text eol=lf
